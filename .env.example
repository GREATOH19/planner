# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Canvas (Profile > Settings > New Access Token) ---
CANVAS_BASE_URL=https://yourschool.instructure.com
CANVAS_TOKEN=
# token이 안 되면 Canvas 캘린더 피드(ICS) URL 사용
CANVAS_ICS_URL=

# --- Google OAuth 클라이언트 (refresh token은 앱의 "Google 연결" 버튼으로 자동 저장) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary

# --- Web Push (npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- 접근 보호: 앱/크론 호출 시 ?key= 또는 x-app-key 헤더 ---
APP_KEY=change-me
CRON_SECRET=   # Vercel Cron이 쓰는 값 (아무 긴 랜덤 문자열)
TIMEZONE=America/Los_Angeles
CLAUDE_SCAN_MODEL=claude-haiku-5-5
# Upstash Redis: Vercel > Storage에서 연결하면 KV_REST_API_URL / KV_REST_API_TOKEN 자동 주입
